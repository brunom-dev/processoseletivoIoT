{
  "version": 1,
  "author": "Bruno",
  "editor": "wokwi",
  "parts": [
    { "type": "board-esp32-devkit-c-v4", "id": "esp", "top": 0, "left": 0, "attrs": {} },
    { "type": "wokwi-led", "id": "led_green", "top": -50, "left": 150, "attrs": { "color": "green" } },
    { "type": "wokwi-led", "id": "led_red", "top": -50, "left": 190, "attrs": { "color": "red" } },
    { "type": "wokwi-pushbutton", "id": "btn1", "top": 50, "left": 150, "attrs": { "color": "blue" } },
    { "type": "wokwi-resistor", "id": "r1", "top": 0, "left": 150, "attrs": { "value": "330" } },
    { "type": "wokwi-resistor", "id": "r2", "top": 0, "left": 190, "attrs": { "value": "330" } }
  ],
  "connections": [
    [ "esp:TX", "$serialMonitor:RX", "", [] ],
    [ "esp:RX", "$serialMonitor:TX", "", [] ],
    [ "led_green:A", "r1:1", "green", [ "v0" ] ],
    [ "r1:2", "esp:18", "green", [ "v0" ] ],
    [ "led_green:C", "esp:GND.1", "black", [ "v0" ] ],
    [ "led_red:A", "r2:1", "red", [ "v0" ] ],
    [ "r2:2", "esp:19", "red", [ "v0" ] ],
    [ "led_red:C", "esp:GND.1", "black", [ "v0" ] ],
    [ "btn1:1.l", "esp:GND.2", "black", [ "v0", "h-50" ] ],
    [ "btn1:2.l", "esp:14", "blue", [ "v0", "h-50" ] ]
  ]
}